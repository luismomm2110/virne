\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Comparação de Topologias: Tree (Hierárquica Binária) e Fat-Tree (\textit  {Datacenter}). A topologia Tree apresenta estrutura hierárquica tradicional com hosts na base e switches em níveis sucessivos. A Fat-Tree apresenta estrutura de \textit  {datacenter} com k=4, caracterizada por múltiplos caminhos e maior redundância.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:topologies-comparison}{{3}{5}{Comparação de Topologias: Tree (Hierárquica Binária) e Fat-Tree (\textit {Datacenter}). A topologia Tree apresenta estrutura hierárquica tradicional com hosts na base e switches em níveis sucessivos. A Fat-Tree apresenta estrutura de \textit {datacenter} com k=4, caracterizada por múltiplos caminhos e maior redundância}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Topologia Waxman-16: Rede Aleatória com 16 Nós. Diferentemente das topologias estruturadas (Tree e Fat-Tree), a Waxman representa uma rede aleatória gerada com parâmetros de dispersão geográfica ($\alpha $=0.5, $\beta $=0.2), simulando características de redes reais de larga escala, com múltiplos nós isolados e grupos conectados variáveis.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:waxman-topology}{{4}{5}{Topologia Waxman-16: Rede Aleatória com 16 Nós. Diferentemente das topologias estruturadas (Tree e Fat-Tree), a Waxman representa uma rede aleatória gerada com parâmetros de dispersão geográfica ($\alpha $=0.5, $\beta $=0.2), simulando características de redes reais de larga escala, com múltiplos nós isolados e grupos conectados variáveis}{figure.4}{}}
